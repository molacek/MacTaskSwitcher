<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is intentionally NOT sandboxed: CGEventTap keyboard interception
	     and the Accessibility (AX) APIs used to raise windows do not work under
	     the App Sandbox. This app is meant for direct / Developer ID distribution,
	     not the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
